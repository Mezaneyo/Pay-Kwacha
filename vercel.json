{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/pay/:linkId", "destination": "/pay.html" },
    { "source": "/api-docs", "destination": "/api-docs.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/policies", "destination": "/policies.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/betting", "destination": "/betting/index.html" },
    { "source": "/betting/", "destination": "/betting/index.html" },
    { "source": "/betting/login", "destination": "/betting/login.html" },
    { "source": "/betting/signup", "destination": "/betting/signup.html" },
    { "source": "/betting/dashboard", "destination": "/betting/dashboard.html" },
    { "source": "/betting/deposit", "destination": "/betting/deposit.html" },
    { "source": "/betting/withdraw", "destination": "/betting/withdraw.html" },
    { "source": "/betting/my-bets", "destination": "/betting/my-bets.html" },
    { "source": "/betting/settings", "destination": "/betting/settings.html" },
    { "source": "/betting/live", "destination": "/betting/live.html" }
  ]
}