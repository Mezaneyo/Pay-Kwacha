{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/service-worker.js", "destination": "/public/service-worker.js" },
    { "source": "/offline.html", "destination": "/public/offline.html" },
    { "source": "/icon-192.png", "destination": "/public/icon-192.png" },
    { "source": "/icon-512.png", "destination": "/public/icon-512.png" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/pay/:linkId", "destination": "/public/pay.html" },
    { "source": "/api-docs", "destination": "/public/api-docs.html" },
    { "source": "/about", "destination": "/public/about.html" },
    { "source": "/faq", "destination": "/public/faq.html" },
    { "source": "/privacy", "destination": "/public/privacy.html" },
    { "source": "/policies", "destination": "/public/policies.html" },
    { "source": "/contact", "destination": "/public/contact.html" },
    { "source": "/betting", "destination": "/public/betting/index.html" },
    { "source": "/betting/", "destination": "/public/betting/index.html" },
    { "source": "/betting/login", "destination": "/public/betting/login.html" },
    { "source": "/betting/signup", "destination": "/public/betting/signup.html" },
    { "source": "/betting/dashboard", "destination": "/public/betting/dashboard.html" },
    { "source": "/betting/deposit", "destination": "/public/betting/deposit.html" },
    { "source": "/betting/withdraw", "destination": "/public/betting/withdraw.html" },
    { "source": "/betting/my-bets", "destination": "/public/betting/my-bets.html" },
    { "source": "/betting/settings", "destination": "/public/betting/settings.html" },
    { "source": "/betting/live", "destination": "/public/betting/live.html" }
  ]
}
